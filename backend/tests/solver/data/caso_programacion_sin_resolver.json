  "rules": {
    "all_activities_mandatory": true,
    "preemption_allowed": false,
    "activity_duration_independent_of_staff_choice": true,
    "exact_personnel_counts_required": true,
    "same_personnel_throughout_activity": true,
    "one_role_per_person_per_activity": true,
    "max_simultaneous_activities_per_person": 1,
    "roles_are_exhaustive": true,
    "resources_held_for_full_activity_duration": true,
    "unavailability_must_not_overlap_activity": true,
    "overtime_allowed": false,
    "all_dependencies": "finish-to-start: successor.start >= predecessor.finish + lag_slots",
    "recurrence_semantics": "Exactamente una ocurrencia por ventana; no se exige una separación exacta entre inicios ni un máximo entre ocurrencias.",
    "periodic_window_formula": "Para ocurrencia k (1..6): start >= 10*(k-1) y finish <= 10*k.",
    "periodic_activity_count_fixed": true,
    "periodic_activities_continue_after_project_close": true,
    "periodic_activities_must_not_be_added_as_close_predecessors_except_as_explicitly_listed": true,
    "cost_units": "Unidades monetarias ficticias por bloque trabajado; no se cobran horas ociosas ni recursos materiales."
  },
  "objectives": {
    "aggregation": "lexicographic",
    "priorities": [
      {
        "priority": 1,
        "sense": "minimize",
        "metric": "start_time",
        "activity_id": "A27"
      },
      {
        "priority": 2,
        "sense": "minimize",
        "metric": "total_personnel_cost",
        "formula": "sum(a.duration_slots * sum(p.cost_per_slot for p assigned to a) for a in all_expanded_activities)"
      }
    ],
    "note": "El objetivo primario NO es el final de la última rutina periódica; es el instante de cierre A27."
  },
